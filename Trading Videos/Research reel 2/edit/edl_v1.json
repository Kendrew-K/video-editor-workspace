  "ranges": [
    {"source": "IMG_0938", "start": 2.10, "end": 5.28, "beat": "INTRO", "quote": "Welcome fellas to day three of my series."},
    {"source": "IMG_0947", "start": 1.62, "end": 10.52, "beat": "INTRO", "quote": "Pernahkah kau penasaran gimana perusahaan besar memprediksi harga stok sebelum news keluar? Jawabannya ada di video ini."},
    {"source": "IMG_0949", "start": 1.95, "end": 6.30, "beat": "SATELLITE", "quote": "Lu pikir lu ke supermarket gak ada yang lacak? Mana ada bos!"},
    {"source": "IMG_0951", "start": 1.80, "end": 11.30, "beat": "SATELLITE", "quote": "Hedge funds pada menggunakan satellite untuk melacak kondisi parkiran di lebih dari 67 ribu toko."},
    {"source": "IMG_0952", "start": 1.40, "end": 7.84, "beat": "SATELLITE", "quote": "Mereka pun beli data transaksi perusahaan untuk rekonstruksi omset sebelum data itu keluar."},
    {"source": "IMG_0955", "start": 1.88, "end": 8.02, "beat": "SATELLITE", "quote": "Menurut report, fans yang menggunakan cara ini dapat menaikkan akurasi mereka sebesar sepuluh persen."},
    {"source": "IMG_0956", "start": 1.62, "end": 7.00, "beat": "WEBSCRAPE", "quote": "Well, what about online? Companies like to deploy something we call web scraping."},
    {"source": "IMG_0957", "start": 1.82, "end": 8.86, "beat": "WEBSCRAPE", "quote": "Sebuah alat yang bisa mengeruk millions of web dari lowongan kerja, harga produk, sampai number of downloads."},
    {"source": "IMG_0960", "start": 1.50, "end": 10.02, "beat": "WEBSCRAPE", "quote": "All of these are factors of growth in a company or the economy. For example, an increase in job listings may indicate a growing industry."},
    {"source": "IMG_0962", "start": 1.85, "end": 6.36, "beat": "GTRENDS", "quote": "Now this may be the most applicable to us: Google Trends."},
    {"source": "IMG_0964", "start": 2.20, "end": 10.12, "beat": "GTRENDS", "quote": "Volume orang yang mencari kata kunci seperti tarif atau utang bisa menjadi peringatan bahwa ada gerakan besar di bawah pasaran."},
    {"source": "IMG_0965", "start": 1.55, "end": 5.96, "beat": "GTRENDS", "quote": "The problem is this information is so public that it's barely an edge."},
    {"source": "IMG_0967", "start": 1.40, "end": 5.42, "beat": "RECAP", "quote": "Ya, at the end of the day, semua teknik ini membahas data yang mentah."},
    {"source": "IMG_0970", "start": 2.10, "end": 10.85, "beat": "TEASE", "quote": "To actually use this data, we have to deploy something called machine learning, in the next video. Peace."}
